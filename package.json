{
    "name": "dhc-components",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        "./style.css": "./dist/dhc-components.css",
        "./Blocks/*": "./dist/Blocks/*.js",
        "./Button/*": "./dist/Button/*.js",
        "./Display/*": "./dist/Display/*.js",
        "./Dropdown": "./dist/Dropdown/*.js",
        "./Form/*": "./dist/Form/*.js",
        "./Indicators/*": "./dist/Indicators/*.js",
        "./Input/*": "./dist/Input/*.js",
        "./LabeledInput": "./dist/LabeledInput/*.js",
        "./Layout/*": "./dist/Layout/*.js",
        "./Multiselect": "./dist/Multiselect/*.js",
        "./Navigation/*": "./dist/Navigation/*.js",
        "./Notifications/*": "./dist/Notifications/*.js",
        "./Views": "./dist/Views/*.js",
        "./Visuals": "./dist/Visuals/*.js",
        "./composables/*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.js"
        }
    },
    "files": [
        "dist/**/*",
        "node_modules/highlight.js/styles/github-dark.css",
        "node_modules/highlight.js/styles/github.css"
    ],
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "build": "vite build",
        "type-check": "vue-tsc --build",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "peerDependencies": {
        "bootstrap": "^5.3.0",
        "vue": "^3.3.0"
    },
    "dependencies": {
        "@fontsource-variable/figtree": "^5.3.0",
        "@fontsource-variable/fira-code": "^5.3.0",
        "@fontsource/zilla-slab": "^5.3.0",
        "@fortawesome/fontawesome-svg-core": "^6.4.0",
        "@fortawesome/free-brands-svg-icons": "^6.4.0",
        "@fortawesome/free-regular-svg-icons": "^6.4.0",
        "@fortawesome/free-solid-svg-icons": "^6.4.0",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@storybook/test": "^8.6.15",
        "@vueform/multiselect": "^2.6.11",
        "axios": "^1.19.0",
        "dayjs": "^1.11.23",
        "highlight.js": "^11.12.0",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.40",
        "vue-i18n": "11",
        "yup": "^1.7.1"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "latest",
        "@storybook/addon-a11y": "^10.5.9",
        "@storybook/addon-docs": "^10.5.9",
        "@storybook/addon-interactions": "^8.6.14",
        "@storybook/addon-vitest": "^10.5.9",
        "@storybook/vue3-vite": "^10.5.9",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/browser-playwright": "latest",
        "@vitest/coverage-v8": "latest",
        "@vue/tsconfig": "^0.9.1",
        "bootstrap": "^5.3.8",
        "npm-run-all2": "^9.0.2",
        "playwright": "latest",
        "sass-embedded": "^1.102.0",
        "storybook": "^10.5.9",
        "typescript": "~6.0.0",
        "vite": "^8.1.5",
        "vite-plugin-vue-devtools": "^8.1.5",
        "vitest": "latest",
        "vue-tsc": "^3.3.7"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}